diff --git a/nnunetv2/training/loss/diff_loss.py b/nnunetv2/training/loss/diff_loss.py
index 9ad6d6e..bc78ef7 100644
--- a/nnunetv2/training/loss/diff_loss.py
+++ b/nnunetv2/training/loss/diff_loss.py
@@ -6,7 +6,24 @@ from nnunetv2.training.loss.dice import MemoryEfficientSoftDiceLoss, SoftSkeleto
 from nnunetv2.training.loss.robust_ce_loss import RobustCrossEntropyLoss
 from nnunetv2.utilities.helpers import softmax_helper_dim1
 
+def _axis_sq_diff_mean(x, y_onehot_u8, dim):
+    """mean((dy - dx)**2) along one spatial axis; y is cast here so the float
+    one-hot never has to be materialised for all axes at once."""
+    n = x.shape[dim]
+    y = y_onehot_u8.to(x.dtype)
+    gt_diff = y.narrow(dim, 1, n - 1) - y.narrow(dim, 0, n - 1)
+    pred_diff = x.narrow(dim, 1, n - 1) - x.narrow(dim, 0, n - 1)
+    return ((gt_diff - pred_diff) ** 2).mean()
+
+
 class DiffLoss(nn.Module):
+    """Same value as the original DiffLoss; memory-efficient for 16 GB GPUs.
+
+    Change vs. the released code (training on an RTX 5070 Ti instead of a
+    96 GB RTX PRO 6000): each axis term is computed separately under gradient
+    checkpointing, and the one-hot target is kept as uint8. The loss is the
+    same average over the three axes of mean((gt_diff - pred_diff)**2).
+    """
     def __init__(self, apply_nonlin: Callable = None, do_bg: bool = True):
         super(DiffLoss, self).__init__()
 
@@ -14,41 +31,30 @@ class DiffLoss(nn.Module):
         self.apply_nonlin = apply_nonlin
 
     def forward(self, x, y, loss_mask=None):
+        from torch.utils.checkpoint import checkpoint
         if self.apply_nonlin is not None:
             x = self.apply_nonlin(x)
 
-        # make everything shape (b, c)
-        axes = tuple(range(2, x.ndim))
-
         with torch.no_grad():
             if x.ndim != y.ndim:
                 y = y.view((y.shape[0], 1, *y.shape[1:]))
 
             if x.shape == y.shape:
-                # if this is the case then gt is probably already a one hot encoding
-                y_onehot = y
+                y_onehot = (y != 0).to(torch.uint8) if y.dtype != torch.uint8 else y
             else:
-                y_onehot = torch.zeros(x.shape, device=x.device)
+                y_onehot = torch.zeros(x.shape, device=x.device, dtype=torch.uint8)
                 y_onehot.scatter_(1, y.long(), 1)
 
             if not self.do_bg:
                 y_onehot = y_onehot[:, 1:]
 
-            gt_diff_x = y_onehot[:, :, 1:] - y_onehot[:, :, :-1]
-            gt_diff_y = y_onehot[:, :, :, 1:] - y_onehot[:, :, :, :-1]
-            gt_diff_z = y_onehot[:, :, :, :, 1:] - y_onehot[:, :, :, :, :-1]
-
-        # this one MUST be outside the with torch.no_grad(): context. Otherwise no gradients for you
         if not self.do_bg:
             x = x[:, 1:]
 
-        pred_diff_x = x[:, :, 1:] - x[:, :, :-1]
-        pred_diff_y = x[:, :, :, 1:] - x[:, :, :, :-1]
-        pred_diff_z = x[:, :, :, :, 1:] - x[:, :, :, :, :-1]
-        
-        loss = (((gt_diff_x - pred_diff_x) ** 2).mean() + ((gt_diff_y - pred_diff_y) ** 2).mean() + ((gt_diff_z - pred_diff_z) ** 2).mean()) / 3.
-
-        return loss
+        loss = 0.
+        for dim in (2, 3, 4):
+            loss = loss + checkpoint(_axis_sq_diff_mean, x, y_onehot, dim, use_reentrant=False)
+        return loss / 3.
 
 class DC_SkelREC_Diff_and_CE_loss(nn.Module):
     def __init__(self, soft_dice_kwargs, soft_skelrec_kwargs, ce_kwargs, diff_kwargs, weight_ce=1, weight_dice=1, weight_srec=1, weight_diff=1, 
